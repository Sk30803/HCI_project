// src/components/MapPicker.js
import React, { useState, useEffect } from "react";
import { MapContainer, TileLayer, Marker, Popup, Polyline } from "react-leaflet";
import L from "leaflet";

// default icon fix for leaflet in CRA/Vite
delete L.Icon.Default.prototype._getIconUrl;
L.Icon.Default.mergeOptions({
  iconRetinaUrl: "https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon-2x.png",
  iconUrl: "https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon.png",
  shadowUrl: "https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png",
});

export default function MapPicker({ initialCenter = [24.8607, 67.0011], onChange, readOnly = false, pickup, dropoff, setPickup, setDropoff }) {
  // initialCenter defaults to Karachi coords for convenience
  const [mapReady, setMapReady] = useState(false);

  useEffect(() => {
    // nothing for now
  }, []);

  const handleMapClick = (e) => {
    if (readOnly) return;
    const { lat, lng } = e.latlng;
    // If pickup not set, set pickup; otherwise set dropoff
    if (!pickup) {
      setPickup({ lat, lng });
      onChange && onChange({ pickup: { lat, lng }, dropoff });
    } else if (!dropoff) {
      setDropoff({ lat, lng });
      onChange && onChange({ pickup, dropoff: { lat, lng } });
    } else {
      // toggle: override dropoff
      setDropoff({ lat, lng });
      onChange && onChange({ pickup, dropoff: { lat, lng } });
    }
  };

  const goToMyLocation = () => {
    if (!navigator.geolocation) return alert("Geolocation not supported");
    navigator.geolocation.getCurrentPosition((pos) => {
      const coords = [pos.coords.latitude, pos.coords.longitude];
      setPickup({ lat: coords[0], lng: coords[1] });
      onChange && onChange({ pickup: { lat: coords[0], lng: coords[1] }, dropoff });
    }, (err) => {
      console.warn(err);
      alert("Could not get location");
    });
  };

  const polylinePositions = [];
  if (pickup && dropoff) {
    polylinePositions.push([pickup.lat, pickup.lng], [dropoff.lat, dropoff.lng]);
  }

  return (
    <div>
      <div style={{ marginBottom: 8 }}>
        {!readOnly && <button onClick={goToMyLocation}>Use My Location</button>}
        <small style={{ marginLeft: 8 }}>
          {pickup ? "Pickup set" : "Tap map to set pickup"} • {dropoff ? "Drop-off set" : "Tap map to set drop-off"}
        </small>
      </div>

      <MapContainer
        center={initialCenter}
        zoom={13}
        scrollWheelZoom
        style={{ height: 300, width: "100%" }}
        whenCreated={() => setMapReady(true)}
        onClick={handleMapClick}
      >
        <TileLayer
          attribution='&copy; OpenStreetMap contributors'
          url="https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png"
        />
        {pickup && <Marker position={[pickup.lat, pickup.lng]}><Popup>Pickup</Popup></Marker>}
        {dropoff && <Marker position={[dropoff.lat, dropoff.lng]}><Popup>Drop-off</Popup></Marker>}
        {polylinePositions.length === 2 && <Polyline positions={polylinePositions} color="blue" />}
      </MapContainer>
    </div>
  );
}
